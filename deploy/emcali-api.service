[Unit]
Description=EMCALI Eder Conversational Agent & M3 Operations API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rommel
WorkingDirectory=/home/rommel/emcali-corpus
Environment=PATH=/home/rommel/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/home/rommel/emcali-corpus/.env
ExecStart=/home/rommel/.local/bin/uv run uvicorn api.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
